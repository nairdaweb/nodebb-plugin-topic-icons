{
	"id": "nodebb-plugin-topic-icons",
	"url": "https://github.com/nairdaweb/nodebb-plugin-topic-icons",
	"library": "library.js",
	"hooks": [
		{ "hook": "static:app.load", "method": "init" },
		{ "hook": "static:api.routes", "method": "addApiRoutes" },
		{ "hook": "filter:admin.header.build", "method": "addAdminNavigation" },
		{ "hook": "filter:settings.set", "method": "onSettingsSave" },
		{ "hook": "action:settings.set", "method": "onSettingsSet" },
		{ "hook": "filter:topic.post", "method": "onTopicPost" },
		{ "hook": "filter:post-queue.save", "method": "onQueueSave" },
		{ "hook": "filter:topic.create", "method": "onTopicCreate" },
		{ "hook": "action:topic.save", "method": "onTopicSave" },
		{ "hook": "filter:post.edit", "method": "onPostEdit" },
		{ "hook": "filter:topic.edit", "method": "onTopicEdit" },
		{ "hook": "action:post.edit", "method": "onPostEdited" },
		{ "hook": "action:topic.move", "method": "onTopicMove" },
		{ "hook": "action:topics.purge", "method": "onTopicsPurge" },
		{ "hook": "action:user.saveSettings", "method": "onUserSaveSettings" },
		{ "hook": "filter:topics.get", "method": "onTopicsGet" },
		{ "hook": "filter:topic.get", "method": "onTopicGet" },
		{ "hook": "filter:middleware.render", "method": "onRender", "priority": 20 }
	],
	"scss": ["scss/topic-icons.scss"],
	"scripts": ["public/client.js"],
	"modules": {
		"../admin/plugins/topic-icons.js": "public/admin.js",
		"topic-icons/icons.js": "lib/icons.js",
		"topic-icons/covers.js": "lib/covers.js"
	},
	"staticDirs": {
		"icons": "static/icons"
	},
	"templates": "templates",
	"languages": "languages",
	"defaultLang": "en-GB"
}
